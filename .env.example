# Copia este archivo a ".env" y completa tus datos. NUNCA subas ".env" a Git.
# Usa SIEMPRE una cuenta DEMO.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# Modo real (opcional). Déjalo vacío hasta estar seguro.
ALLOW_LIVE_TRADING=

# Par y timeframe por defecto (el nombre debe ser EXACTO al de tu broker)
MARKET_SYMBOL=EURUSD
MARKET_TIMEFRAME=H1
